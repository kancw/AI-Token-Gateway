# Server Port
PORT=3000

# JWT Authentication Secret Key (change in production)
JWT_SECRET=super_secret_signing_key_for_gateway_tokens_12345

# Google Gemini API Key (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Gemini Model Names
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
